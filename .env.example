# OpenSea API key — get one at https://docs.opensea.io/reference/api-keys
OPENSEA_API_KEY=your_opensea_api_key_here

# Neon Postgres connection string — set automatically when you add a Neon database
# in the Vercel dashboard (Storage → Connect Store → Neon Postgres)
# Format: postgres://user:password@host/dbname?sslmode=require
POSTGRES_URL=postgres://...

# Gmail SMTP — use your Gmail address and a Google App Password (NOT your normal password)
# How to create an App Password:
#   1. Go to myaccount.google.com → Security
#   2. Enable 2-Step Verification
#   3. Go to Security → App Passwords → create one named "OfferTracker"
#   4. Paste the 16-character password below
GMAIL_USER=your_gmail@gmail.com
GMAIL_APP_PASSWORD=your_16_char_app_password

# Email address to receive alerts
ALERT_EMAIL=edalosov@gmail.com
